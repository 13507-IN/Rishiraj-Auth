PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/auth_system
JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_REFRESH_SECRET=replace_with_strong_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
FRONTEND_URL=http://localhost:4000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
REDIS_REQUIRED=false
# SMTP (optional — uses Ethereal test account if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@rishiraj-auth.dev
# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
# Default environment for new API keys
DEFAULT_ENVIRONMENT=DEVELOPMENT
