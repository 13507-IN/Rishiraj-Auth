PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/auth_system
JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_REFRESH_SECRET=replace_with_strong_secret
OAUTH_STATE_SECRET=replace_with_a_different_strong_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=
FACEBOOK_GRAPH_API_VERSION=v26.0
FRONTEND_URL=http://localhost:4000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
RECOVERY_RATE_LIMIT_MAX=5
API_KEY_VALIDATE_RATE_LIMIT_MAX=1000
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
REDIS_REQUIRED=false
# SMTP (recommended outside local development; local development can use Ethereal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@rishiraj-auth.dev
# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
# Set true only for local testing to return verification/reset tokens and test-email previews.
DEV_AUTH_TOKENS=false
# Set only when behind a trusted reverse proxy; e.g. 1 or loopback, linklocal, uniquelocal.
TRUST_PROXY=
# Default environment for new API keys
DEFAULT_ENVIRONMENT=DEVELOPMENT
