generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AuditAction {
  LOGIN
  LOGOUT
  FAILED_LOGIN
}

model Tenant {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  users     User[]
  apiKeys   ApiKey[]
  audits    AuditLog[]

  @@unique([name])
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  password     String?
  role         Role           @default(USER)
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  isVerified   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
  apiKeys      ApiKey[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]

  @@index([tenantId])
}

model RefreshToken {
  id                String   @id @default(uuid())
  token             String   @unique
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  revokedAt         DateTime?
  replacedByTokenId String?
  deviceId          String?

  @@index([userId])
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  consumedAt DateTime?

  @@index([userId])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  consumedAt DateTime?

  @@index([userId])
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  tenantId  String?
  tenant    Tenant?     @relation(fields: [tenantId], references: [id])
  action    AuditAction
  ip        String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([tenantId])
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  services  String[]
  last4     String?
  userId    String
  tenantId  String
  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([tenantId])
}
